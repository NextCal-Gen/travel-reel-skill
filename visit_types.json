    "heritage": {"label": "Heritage / temple / museum", "osm": ["historic:*", "amenity:place_of_worship", "tourism:museum", "tourism:attraction", "tourism:viewpoint"], "location_default": "ask"},
    "market":   {"label": "Street / market",  "osm": ["shop:*", "amenity:marketplace", "place:square"], "location_default": "ask"},
